{
  "name": "drusniel-voxels-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build:runtime": "node ./scripts/build-editor-runtime.mjs --release",
    "build:runtime:debug": "node ./scripts/build-editor-runtime.mjs --debug",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:desktop": "tauri build --config src-tauri/tauri.sidecar.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "vitest run src/state/editorStore.test.ts src/runtime/RuntimeClient.test.ts src/features/terrain/terrainRecipe.test.ts",
    "test:smoke": "playwright test --config playwright.config.ts --grep-invert @visual-review",
    "test:visual-review": "playwright test --config playwright.config.ts tests/editor-visual-review.spec.ts --project chromium"
  },
  "dependencies": {
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-react": "^6.0.1",
    "immer": "^11.1.6",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.1.1"
}
